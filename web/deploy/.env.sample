# Read by two different things: `make deploy` hands it to compose, and `make run`
# hands it to uv. Single-quote anything that might contain a $, or both of them
# will expand it away and leave you with a silently truncated value. Single
# quotes are the one form they agree on. Escaping with a backslash works for uv
# but not compose, and $$ doubling only applies to values written straight into
# compose.yml, not here.

# Hostname Traefik routes to this app
DOMAIN=

# Basicauth credentials, generated with:
#   htpasswd -nbB <user> <password>
# The bcrypt hash is full of $, so the quotes below are not optional.
BASIC_AUTH_USERS=''

# CloudAMQP MQTT. Same credentials the firmware uses, but over TLS on 8883
# rather than plain 1883, since this connects from a VPS across the public
# internet. Set MQTT_TLS=0 and MQTT_PORT=1883 if the instance has no TLS listener.
MQTT_HOST=
MQTT_PORT=8883
MQTT_USER=''
MQTT_PASSWORD=''
MQTT_TLS=1
